# Generated by deployment/ha/render.py. PRIVATE health credentials; mode 0600.
# Stable PostgreSQL endpoint for applications. HAProxy routes only to the node
# whose Patroni REST /primary role check succeeds, so a promoted
# successor is reachable on exactly the same host:port.
global
    maxconn 200
    stats socket $stats_socket mode 600 level admin
    log stdout format raw local0 notice

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 2s
    timeout client 30s
    timeout server 30s
    timeout check 1s
    retries 1

frontend postgres_primary
    bind 127.0.0.1:$primary_port
    default_backend postgres_primary_nodes

backend postgres_primary_nodes
    option httpchk GET /primary
    http-check send hdr Authorization "Basic $health_auth"
    http-check expect status 200
    # HAProxy assumes a server is UP until the first role check reports
    # otherwise (3.0 has no init-state keyword). Start this endpoint after
    # Patroni has an elected leader; the role check then selects it. The
    # proxy sends Basic credentials, but Patroni health GETs are unauthenticated
    # by design: loopback-only binding is the actual access boundary.
    # it, and callers gate writes on stable routing.
    default-server check inter 1000ms fall 2 rise 1 on-marked-down shutdown-sessions
$servers

frontend postgres_replica
    bind 127.0.0.1:$replica_port
    default_backend postgres_replica_nodes

backend postgres_replica_nodes
    option httpchk GET /replica
    http-check send hdr Authorization "Basic $health_auth"
    http-check expect status 200
    # HAProxy assumes a server is UP until the first role check reports
    # otherwise (3.0 has no init-state keyword). Start this endpoint after
    # Patroni has an elected leader; the role check then selects it. The
    # proxy sends Basic credentials, but Patroni health GETs are unauthenticated
    # by design: loopback-only binding is the actual access boundary.
    # it, and callers gate writes on stable routing.
    default-server check inter 1000ms fall 2 rise 1 on-marked-down shutdown-sessions
$servers
