--name=$name
--data-dir=$data_dir
--listen-client-urls=https://127.0.0.1:$client_port
--advertise-client-urls=https://127.0.0.1:$client_port
--listen-peer-urls=https://127.0.0.1:$peer_port
--initial-advertise-peer-urls=https://127.0.0.1:$peer_port
--initial-cluster=$initial_cluster
--initial-cluster-token=$cluster_token
--initial-cluster-state=new
--cert-file=$cert
--key-file=$key
--trusted-ca-file=$ca
--client-cert-auth
--peer-cert-file=$peer_cert
--peer-key-file=$peer_key
--peer-trusted-ca-file=$peer_ca
--peer-client-cert-auth
--logger=zap
--log-level=warn
--quota-backend-bytes=67108864
--auto-compaction-mode=periodic
--auto-compaction-retention=5m
