# Generated by deployment/ha/render.py for $node_name ($environment).
# PRIVATE: contains database credentials; keep mode 0600 and out of source control.
scope: $scope
namespace: /rootyard/
name: $node_name

restapi:
  listen: 127.0.0.1:$rest_port
  connect_address: $postgres_host_ip:$rest_port
  authentication:
    username: $rest_user
    password: $rest_password

etcd3:
  hosts:
$etcd_host_lines
  protocol: https
  cacert: $etcd_ca
  cert: $etcd_client_cert
  key: $etcd_client_key

bootstrap:
  dcs:
    ttl: $ttl
    loop_wait: $loop_wait
    retry_timeout: $retry_timeout
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    synchronous_mode_strict: true
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        synchronous_commit: remote_apply
        wal_level: replica
        wal_log_hints: 'on'
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: 'on'
  initdb:
    - encoding: UTF8
    - data-checksums
    - auth-local=trust
    - auth-host=scram-sha-256
  post_bootstrap: $post_bootstrap

postgresql:
  bin_dir: $pg_bin_dir
  data_dir: $data_dir
  listen: $postgres_host_ip:$pg_port
  connect_address: $postgres_host_ip:$pg_port
  authentication:
    superuser:
      username: postgres
      password: $superuser_password
    replication:
      username: repl
      password: $repl_password
      sslmode: verify-full
      sslrootcert: $ca
    rewind:
      username: postgres
      password: $superuser_password
  parameters:
    unix_socket_directories: '$socket_dir'
    password_encryption: scram-sha-256
    ssl: 'on'
    ssl_cert_file: $server_cert
    ssl_key_file: $server_key
    ssl_ca_file: $ca
    ssl_min_protocol_version: TLSv1.3
  pg_hba:
    - local all all trust
    - local replication all trust
    - hostssl all all 127.0.0.1/32 scram-sha-256
    - hostssl all all $postgres_host_ip/32 scram-sha-256
    - hostssl all all ::1/128 scram-sha-256
    - hostssl replication repl 127.0.0.1/32 scram-sha-256
    - hostssl replication repl $postgres_host_ip/32 scram-sha-256
    - hostssl replication repl ::1/128 scram-sha-256
    - hostnossl all all 0.0.0.0/0 reject
    - hostnossl replication repl 0.0.0.0/0 reject
    - hostnossl all all ::/0 reject
    - hostnossl replication repl ::/0 reject
$watchdog_block
